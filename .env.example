# Modèle des variables d'environnement (aucun secret ici). Copier vers .env.local en développement ;
# en production, définir ces variables côté hébergeur (voir docs/MISE-EN-LIGNE.md).

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=remplacer-par-une-longue-chaine-aleatoire
DATABASE_URL="mysql://utilisateur:mot_de_passe@127.0.0.1:3306/base?serverVersion=8.0&charset=utf8mb4"
MAILER_DSN=smtp://utilisateur:mot_de_passe@smtp.exemple.invalid:587
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=flock

# Stripe : clés de TEST en développement, clés LIVE en production ; secret du webhook propre à chaque environnement
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Dossier des PDF de factures et d'avoirs (hors de public/, à sauvegarder avec la base)
# FACTURES_DIR=/var/www/factures

# Mode démonstration : 1 = bandeau et filigrane (défaut), 0 = boutique réelle
BOUTIQUE_MODE_DEMO=1

# NE JAMAIS définir LOGIN_LIMITE en production (réservée aux tests de bout en bout).
