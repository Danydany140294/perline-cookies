{% extends 'base.html.twig' %}

{% block title %}Renvoyer le lien de confirmation — {{ boutique.nom_marque }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-creme py-12 px-4">
    <div class="max-w-md mx-auto bg-white rounded-2xl shadow-sm p-8">
        <h1 class="text-2xl font-bold text-chocolat mb-2">Confirmer mon adresse e-mail</h1>
        <p class="text-gray-500 text-sm mb-6">Saisissez l'adresse de votre compte : nous vous renverrons le lien de confirmation.</p>

        {% for type, messages in app.flashes %}{% for message in messages %}
            <div class="mb-4 px-4 py-3 rounded-lg text-sm font-medium {{ type == 'success' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' }}">{{ message }}</div>
        {% endfor %}{% endfor %}

        <form method="post" action="{{ path('app_renvoyer_verification') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('renvoyer_verification') }}">
            <label for="email" class="block text-sm font-medium text-gray-600 mb-1">Adresse e-mail</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm">
            <button type="submit" class="mt-4 w-full bg-chocolat text-white rounded-xl py-2.5 font-medium">Renvoyer le lien</button>
        </form>
        <p class="mt-4 text-center"><a href="{{ path('app_login') }}" class="text-sm text-gray-400 hover:text-chocolat">← Retour à la connexion</a></p>
    </div>
</div>
{% endblock %}
