{# templates/user/mon_compte.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon Compte - Perline{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/perline-dashboard.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Pacifico&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="dashboard-wrapper">
    <div class="dashboard-container">
        <main class="dashboard-main">

            {# SIDEBAR - Menu de navigation #}
            <aside class="dashboard-sidebar">
                <div class="sidebar-content">
                    <div class="user-header">

                        {# Avatar : photo si dispo, sinon initiales #}
                        <div class="user-avatar-wrapper" style="cursor:pointer" onclick="document.getElementById('input-avatar').click()">
                            {% if app.user.avatar %}
                                <div class="user-avatar" id="avatar-preview"
                                     style="background-image: url('{{ asset('asset/images/home/' ~ app.user.avatar) }}');"></div>
                            {% else %}
                                <div class="user-avatar user-avatar-initiales" id="avatar-preview">
                                    {{ app.user.initiales }}
                                </div>
                            {% endif %}
                            <div class="user-badge">
                                <span class="material-symbols-outlined">verified</span>
                            </div>
                            <div class="avatar-overlay">
                                <span class="material-symbols-outlined">photo_camera</span>
                            </div>
                            <input type="file" id="input-avatar" accept="image/*" style="display:none">
                        </div>

                        <div class="user-info">
                            <h1 class="user-name">{{ app.user.prenom }} {{ app.user.nom }}</h1>
                            <p class="user-title">Client Perline</p>
                        </div>
                    </div>

                    <nav class="sidebar-nav">
                        <a href="#profil" class="nav-item active" data-tab="profil">
                            <span class="material-symbols-outlined">dashboard</span>
                            <span class="nav-text">Mon Profil</span>
                        </a>
                        <a href="#commandes" class="nav-item" data-tab="commandes">
                            <span class="material-symbols-outlined">shopping_bag</span>
                            <span class="nav-text">Mes Commandes</span>
                        </a>
                        <a href="#informations" class="nav-item" data-tab="informations">
                            <span class="material-symbols-outlined">badge</span>
                            <span class="nav-text">Mes Informations</span>
                        </a>
                        <a href="#adresses" class="nav-item" data-tab="adresses">
                            <span class="material-symbols-outlined">location_on</span>
                            <span class="nav-text">Mes Adresses</span>
                        </a>
                        <div class="nav-divider"></div>
                        <a href="{{ path('app_logout') }}" class="nav-item logout-item">
                            <span class="material-symbols-outlined">logout</span>
                            <span class="nav-text">Déconnexion</span>
                        </a>
                    </nav>
                </div>
            </aside>

            {# CONTENU PRINCIPAL #}
            <div class="dashboard-content">

                <header class="content-header">
                    <h2 class="welcome-title">Bonjour {{ app.user.prenom }} !</h2>
                    <p class="welcome-subtitle">Heureux de vous revoir. Vos cookies vous attendent.</p>
                </header>

                {# ==================== ONGLET 1 : Mon Profil ==================== #}
                <div id="tab-profil" class="tab-content active">
                    <div class="cards-grid">

                        {# Carte Dernière commande #}
                        {% set derniereCommande = app.user.commandes|last %}
                        <div class="card card-order">
                            <div class="card-body">
                                {% if derniereCommande %}
                                    <div class="card-header-flex">
                                        <div>
                                            <h3 class="card-title">Dernière commande</h3>
                                            <p class="card-subtitle">{{ derniereCommande.numeroCommande }} — {{ derniereCommande.dateCommande|date('d M Y') }}</p>
                                        </div>
                                        <span class="badge badge-success">
                                            <span class="badge-dot"></span>
                                            {{ derniereCommande.statutLabel }}
                                        </span>
                                    </div>
                                    <div class="order-preview">
                                        <div class="order-images">
                                            {% for ligne in derniereCommande.lignesCommande|slice(0, 2) %}
                                                {% if ligne.produit %}
                                                    <img src="{{ asset('asset/images/produits/' ~ ligne.produit.image) }}" alt="{{ ligne.produit.name }}" class="order-img">
                                                {% endif %}
                                            {% endfor %}
                                            {% if derniereCommande.lignesCommande|length > 2 %}
                                                <div class="order-img-more">+{{ derniereCommande.lignesCommande|length - 2 }}</div>
                                            {% endif %}
                                        </div>
                                        <div class="order-info">
                                            <p class="order-name">{{ derniereCommande.totalTTC|number_format(2, ',', ' ') }}€</p>
                                            <p class="order-delivery">{{ derniereCommande.statutLabel }}</p>
                                        </div>
                                    </div>
                                {% else %}
                                    <p class="empty-state">Vous n'avez pas encore passé de commande.</p>
                                {% endif %}
                            </div>
                            {% if derniereCommande %}
                                <a href="{{ path('app_compte_commande', {id: derniereCommande.id}) }}" class="btn btn-primary btn-full">
                                    <span class="material-symbols-outlined">local_shipping</span>
                                    Suivre ma livraison
                                </a>
                            {% endif %}
                            <span class="card-icon-bg material-symbols-outlined">package</span>
                        </div>

{% if boutique.fonctions.points_fidelite %}
                        {# Carte Points de fidélité #}
                        <div class="card card-loyalty">
                            <div class="card-body">
                                <div class="card-header-flex">
                                    <div>
                                        <h3 class="loyalty-title">Club Miettes d'Or</h3>
                                        <p class="loyalty-subtitle">Votre solde de gourmandise</p>
                                    </div>
                                    <span class="material-symbols-outlined loyalty-icon">loyalty</span>
                                </div>
                                <div class="loyalty-points">
                                    <span class="points-number">{{ app.user.pointsFidelite }}</span>
                                    <span class="points-label">points</span>
                                </div>
                                <div class="loyalty-reward">
                                    <p class="reward-label">RÉCOMPENSE DISPONIBLE</p>
                                    <div class="reward-card">
                                        <div class="reward-content">
                                            <span class="material-symbols-outlined">redeem</span>
                                            <span class="reward-text">1 Cookie Triple Chocolat OFFERT</span>
                                        </div>
                                        <button class="btn-reward">UTILISER</button>
                                    </div>
                                </div>
                            </div>
                            <div class="loyalty-progress">
                                <p class="progress-text">Prochain palier : 1500 pts</p>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: {{ (app.user.pointsFidelite / 1500 * 100)|number_format(0) }}%;"></div>
                                </div>
                            </div>
                        </div>
{% endif %}

                    </div>

{% if boutique.fonctions.favoris %}
                    {# Section Favoris #}
                    <section class="favorites-section">
                        <div class="section-header">
                            <h3 class="section-title">
                                <span class="material-symbols-outlined">favorite</span>
                                Vos Incontournables
                            </h3>
                            <div class="section-nav">
                                <button class="nav-btn" id="favPrev">
                                    <span class="material-symbols-outlined">chevron_left</span>
                                </button>
                                <button class="nav-btn" id="favNext">
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </button>
                            </div>
                        </div>
                        <div class="favorites-slider" id="favoritesSlider">
                            {% if app.user.favoris|length > 0 %}
                                {% for produit in app.user.favoris %}
                                    <div class="product-card">
                                        <div class="product-image">
                                            <img src="{{ asset('asset/images/produits/' ~ produit.image) }}" alt="{{ produit.name }}">
                                            <div class="product-overlay">
                                                <button class="btn-add" onclick="window.location.href='{{ path('app_panier_ajouter_produit', {id: produit.id}) }}'">Ajouter vite !</button>
                                            </div>
                                        </div>
                                        <h4 class="product-name">{{ produit.name }}</h4>
                                        <p class="product-price">{{ produit.prix|number_format(2, ',', ' ') }}€</p>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <p class="empty-state">Vous n'avez pas encore de favoris. Explorez notre boutique !</p>
                            {% endif %}
                        </div>
                    </section>
{% endif %}
                </div>

                {# ==================== ONGLET 2 : Mes Commandes ==================== #}
                <div id="tab-commandes" class="tab-content">
                    <div class="tab-inner">
                        <h3 class="tab-title">Mes Commandes</h3>
                        <p class="tab-description">Retrouvez l'historique de toutes vos commandes</p>
                        <div class="orders-list">
                            {% if app.user.commandes|length > 0 %}
                                {% for commande in app.user.commandes %}
                                    <div class="order-item">
                                        <div class="order-header">
                                            <p><strong>{{ commande.numeroCommande }}</strong></p>
                                            <span class="badge {{ commande.statutBadgeClass }}">
                                                {{ commande.statutLabel }}
                                            </span>
                                        </div>
                                        <p>Date : {{ commande.dateCommande|date('d/m/Y') }}</p>
                                        <p><a href="{{ path('app_compte_commande', {id: commande.id}) }}" class="btn btn-sm btn-outline">Voir le détail</a></p>
                                        <p>{{ commande.nombreLignes }} article(s) - {{ commande.nombreTotalArticles }} unité(s)</p>
                                        <p><strong>Total : {{ commande.totalTTC|number_format(2, ',', ' ') }}€</strong></p>
                                        {% if commande.enCours %}
                                            <p class="text-info">{{ commande.messageLivraison }}</p>
                                        {% endif %}
                                        {% if commande.statut.value == 'retournee' %}
                                            <p class="text-warning">Votre colis nous a été retourné. Nous vous contactons pour convenir d'un remboursement ou d'une réexpédition.</p>
                                        {% endif %}
                                        {% if commande.dateExpedition or commande.numeroSuivi %}
                                            <div class="order-suivi">
                                                {% if commande.dateExpedition %}<p>Expédiée le {{ commande.dateExpedition|date('d/m/Y') }}{% if commande.transporteur %} avec {{ commande.transporteur }}{% endif %}</p>{% endif %}
                                                {% if commande.numeroSuivi %}
                                                    <p>Numéro de suivi : <strong>{{ commande.numeroSuivi }}</strong>
                                                    {% set lien = lien_suivi(commande) %}{% if lien %} — <a href="{{ lien }}" target="_blank" rel="noopener noreferrer">Suivre mon colis</a>{% endif %}</p>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                        {% if commande.dateLivraison %}<p>Livrée le {{ commande.dateLivraison|date('d/m/Y') }}</p>{% endif %}
                                        {% if commande.factures|length > 0 %}
                                            <div class="order-documents">
                                                {% for document in commande.factures %}
                                                    <a href="{{ path('app_facture_telecharger', {id: document.id}) }}" class="btn btn-sm {{ document.avoir ? 'btn-outline' : 'btn-primary' }}">
                                                        <span class="material-symbols-outlined">download</span>
                                                        {{ document.avoir ? 'Télécharger l\'avoir' : 'Télécharger la facture' }} {{ document.numero }}
                                                    </a>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            {% else %}
                                <p class="empty-state">Vous n'avez pas encore passé de commande.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# ==================== ONGLET 3 : Mes Informations ==================== #}
                <div id="tab-informations" class="tab-content">
                    <div class="tab-inner">
                        <h3 class="tab-title">Mes Informations</h3>
                        <p class="tab-description">Gérez vos informations personnelles</p>

                        <div class="info-card">
                            <div class="info-card-header">
                                <div class="info-header-content">
                                    <span class="material-symbols-outlined info-header-icon">person</span>
                                    <div>
                                        <h4 class="info-header-title">Informations personnelles</h4>
                                        <p class="info-header-subtitle">Vos coordonnées et informations de contact</p>
                                    </div>
                                </div>
                                <div class="info-header-actions">
                                    <button type="button" class="btn btn-outline btn-sm" id="btn-modifier">
                                        <span class="material-symbols-outlined">edit</span>
                                        Modifier
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm" id="btn-enregistrer" style="display:none">
                                        <span class="material-symbols-outlined">save</span>
                                        Enregistrer
                                    </button>
                                    <button type="button" class="btn btn-outline btn-sm" id="btn-annuler" style="display:none">
                                        <span class="material-symbols-outlined">close</span>
                                        Annuler
                                    </button>
                                </div>
                            </div>

                            <div class="info-grid">

                                {# Email — non éditable #}
                                <div class="info-item">
                                    <div class="info-icon-wrapper">
                                        <span class="material-symbols-outlined">mail</span>
                                    </div>
                                    <div class="info-content">
                                        <label class="info-label">Email</label>
                                        <p class="info-value">{{ app.user.email }}</p>
                                    </div>
                                </div>

                                {# Nom #}
                                <div class="info-item">
                                    <div class="info-icon-wrapper">
                                        <span class="material-symbols-outlined">badge</span>
                                    </div>
                                    <div class="info-content">
                                        <label class="info-label">Nom</label>
                                        <p class="info-value" id="view-nom">{{ app.user.nom }}</p>
                                        <input type="text" class="form-control" id="edit-nom" value="{{ app.user.nom }}" style="display:none">
                                    </div>
                                </div>

                                {# Prénom #}
                                <div class="info-item">
                                    <div class="info-icon-wrapper">
                                        <span class="material-symbols-outlined">person</span>
                                    </div>
                                    <div class="info-content">
                                        <label class="info-label">Prénom</label>
                                        <p class="info-value" id="view-prenom">{{ app.user.prenom }}</p>
                                        <input type="text" class="form-control" id="edit-prenom" value="{{ app.user.prenom }}" style="display:none">
                                    </div>
                                </div>

                                {# Téléphone #}
                                <div class="info-item">
                                    <div class="info-icon-wrapper">
                                        <span class="material-symbols-outlined">phone</span>
                                    </div>
                                    <div class="info-content">
                                        <label class="info-label">Téléphone</label>
                                        <p class="info-value" id="view-telephone">{{ app.user.telephone ?? 'Non renseigné' }}</p>
                                        <input type="tel" class="form-control" id="edit-telephone" value="{{ app.user.telephone ?? '' }}" style="display:none">
                                    </div>
                                </div>

                                {# Date de naissance #}
                                <div class="info-item">
                                    <div class="info-icon-wrapper">
                                        <span class="material-symbols-outlined">cake</span>
                                    </div>
                                    <div class="info-content">
                                        <label class="info-label">Date de naissance</label>
                                        <p class="info-value" id="view-dateNaissance">
                                            {{ app.user.dateNaissance ? app.user.dateNaissance|date('d/m/Y') : 'Non renseignée' }}
                                        </p>
                                        <input type="date" class="form-control" id="edit-dateNaissance"
                                               value="{{ app.user.dateNaissance ? app.user.dateNaissance|date('Y-m-d') : '' }}" style="display:none">
                                    </div>
                                </div>

                                {# Membre depuis — non éditable #}
                                <div class="info-item">
                                    <div class="info-icon-wrapper">
                                        <span class="material-symbols-outlined">schedule</span>
                                    </div>
                                    <div class="info-content">
                                        <label class="info-label">Membre depuis</label>
                                        <p class="info-value">
                                            {{ app.user.dateInscription ? app.user.dateInscription|date('d/m/Y') : 'Non disponible' }}
                                        </p>
                                    </div>
                                </div>

                            </div>
                        </div>

{% if boutique.fonctions.points_fidelite %}
                        {# Carte de fidélité #}
                        <div class="info-loyalty-card">
                            <div class="info-loyalty-content">
                                <div class="info-loyalty-icon-wrapper">
                                    <span class="material-symbols-outlined">redeem</span>
                                </div>
                                <div class="info-loyalty-text">
                                    <h4 class="info-loyalty-title">Points de fidélité</h4>
                                    <p class="info-loyalty-subtitle">Cumulez des points à chaque achat</p>
                                </div>
                            </div>
                            <div class="info-loyalty-points">
                                <span class="points-number">{{ app.user.pointsFidelite }}</span>
                                <span class="points-label">points</span>
                            </div>
                        </div>
{% endif %}

                        {# Section sécurité #}
                        <div class="info-security-section">
                            <h4 class="info-security-title">
                                <span class="material-symbols-outlined">security</span>
                                Sécurité
                            </h4>
                            <div class="info-security-actions">
                                <a href="{{ path('app_compte_mot_de_passe') }}" class="btn btn-outline" id="lien-mot-de-passe">
                                    <span class="material-symbols-outlined">lock</span>
                                    Modifier mon mot de passe
                                </a>
                                <a href="{{ path('app_compte_donnees') }}" class="btn btn-outline" id="lien-donnees">
                                    <span class="material-symbols-outlined">database</span>
                                    Mes données et suppression du compte
                                </a>
                                <a href="{{ path('app_compte_email') }}" class="btn btn-outline" id="lien-email">
                                    <span class="material-symbols-outlined">mail</span>
                                    Modifier mon adresse e-mail
                                </a>
                            </div>
                        </div>

                    </div>
                </div>

                {# ==================== ONGLET 4 : Mes Adresses ==================== #}
                {# Une seule gestion des adresses : la page /compte/adresses (aucun formulaire dupliqué ici) #}
                <div id="tab-adresses" class="tab-content">
                    <div class="tab-inner">
                        <h3 class="tab-title">Mes Adresses</h3>
                        <p class="tab-description">Gérez vos adresses de livraison</p>

                        {% if app.user.adresses|length > 0 %}
                            <ul class="adresses-resume">
                                {% for adresse in app.user.adresses %}
                                    <li>
                                        <strong>{{ adresse.nom }}</strong>{% if adresse.parDefaut %} <span class="badge badge-success">Par défaut</span>{% endif %}<br>
                                        {{ adresse.rue }}{% if adresse.complement %}, {{ adresse.complement }}{% endif %}, {{ adresse.codePostal }} {{ adresse.ville }}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <div class="addresses-empty-state">
                                <span class="material-symbols-outlined address-empty-icon">location_off</span>
                                <p>Vous n'avez pas encore enregistré d'adresse.</p>
                            </div>
                        {% endif %}

                        <a href="{{ path('app_adresses_index') }}" class="btn btn-primary" id="lien-gerer-adresses">
                            <span class="material-symbols-outlined">edit_location</span>
                            Gérer mes adresses
                        </a>
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/perline-dashboard.js') }}"></script>
<script>
function initInlineEditProfil() {
    const btnModifier    = document.getElementById('btn-modifier');
    const btnEnregistrer = document.getElementById('btn-enregistrer');
    const btnAnnuler     = document.getElementById('btn-annuler');

    if (!btnModifier || !btnEnregistrer || !btnAnnuler) return;

    const champs = ['nom', 'prenom', 'telephone', 'dateNaissance'];

    btnModifier.addEventListener('click', function () {
        champs.forEach(champ => {
            document.getElementById('view-' + champ).style.display = 'none';
            document.getElementById('edit-' + champ).style.display = 'block';
        });
        btnModifier.style.display    = 'none';
        btnEnregistrer.style.display = 'inline-block';
        btnAnnuler.style.display     = 'inline-block';
    });

    btnAnnuler.addEventListener('click', function () {
        champs.forEach(champ => {
            document.getElementById('view-' + champ).style.display = 'block';
            document.getElementById('edit-' + champ).style.display = 'none';
        });
        btnModifier.style.display    = 'inline-block';
        btnEnregistrer.style.display = 'none';
        btnAnnuler.style.display     = 'none';
    });

    btnEnregistrer.addEventListener('click', function () {
        const payload = {};
        champs.forEach(champ => {
            payload[champ] = document.getElementById('edit-' + champ).value;
        });

        fetch('{{ path('app_user_update_profil') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{{ csrf_token('profil') }}' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json().then(data => ({ ok: res.ok, data })))
        .then(({ ok, data }) => {
            if (!ok && !data.error) throw new Error('Erreur serveur');
            return data;
        })
        .then(data => {
            if (data.success) {
                champs.forEach(champ => {
                    const span  = document.getElementById('view-' + champ);
                    const input = document.getElementById('edit-' + champ);
                    if (span && input) span.textContent = input.value;
                    span.style.display  = 'block';
                    input.style.display = 'none';
                });
                btnModifier.style.display    = 'inline-block';
                btnEnregistrer.style.display = 'none';
                btnAnnuler.style.display     = 'none';
                showNotification('Profil mis à jour !', 'success');
            } else {
                showNotification(data.error || 'Erreur lors de la mise à jour', 'error');
            }
        })
        .catch((err) => {
            console.error('Erreur update profil :', err);
            showNotification('Une erreur est survenue : ' + err.message, 'error');
        });
    });
}

function initAvatarUpload() {
    const input = document.getElementById('input-avatar');
    if (!input) return;

    input.addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;

        // Redimensionne et compresse avant envoi
        compressImage(file, 800, 0.85).then(blob => {
            const formData = new FormData();
            formData.append('avatar', blob, file.name);

            fetch('{{ path('app_user_update_avatar') }}', {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': '{{ csrf_token('profil') }}' },
                body: formData
            })
            .then(res => {
                if (!res.ok) throw new Error('Statut HTTP : ' + res.status);
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    const preview = document.getElementById('avatar-preview');
                    preview.textContent = '';
                    preview.classList.remove('user-avatar-initiales');
                    preview.style.backgroundImage = `url('${data.avatarUrl}?t=${Date.now()}')`;
                    showNotification('Photo de profil mise à jour !', 'success');
                } else {
                    showNotification(data.error || 'Erreur lors de l\'upload', 'error');
                }
            })
            .catch(err => {
                console.error('Erreur avatar :', err);
                showNotification('Erreur : ' + err.message, 'error');
            });
        });
    });
}


function compressImage(file, maxSize, quality) {
    return new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(file);

        img.onload = () => {
            URL.revokeObjectURL(url);

            let { width, height } = img;

            // Calcul du ratio pour ne pas dépasser maxSize
            if (width > height && width > maxSize) {
                height = Math.round((height * maxSize) / width);
                width  = maxSize;
            } else if (height > width && height > maxSize) {
                width  = Math.round((width * maxSize) / height);
                height = maxSize;
            } else if (width > maxSize) {
                height = maxSize;
                width  = maxSize;
            }

            const canvas = document.createElement('canvas');
            canvas.width  = width;
            canvas.height = height;

            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            canvas.toBlob(
                blob => blob ? resolve(blob) : reject(new Error('Compression échouée')),
                'image/jpeg',
                quality
            );
        };

        img.onerror = () => reject(new Error('Impossible de lire l\'image'));
        img.src = url;
    });
}
document.addEventListener('DOMContentLoaded', function () {
    initInlineEditProfil();
    initAvatarUpload();
});
</script>
{% endblock %}
