{% extends 'base.html.twig' %}

{% block title %}Mes adresses — {{ boutique.nom_marque }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-creme py-12 px-4">
    <div class="max-w-4xl mx-auto">

        {# Titre #}
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-chocolat">Mes adresses</h1>
            <p class="text-gray-500 mt-1">Gérez vos adresses de livraison</p>
        </div>

        {% include 'compte/_adresses_vue.html.twig' with {adresses: app.user.adresses, depuis: false} %}

        {# Retour #}
        <div class="mt-8">
            <a href="{{ path('app_home') }}" class="text-sm text-gray-400 hover:text-chocolat transition">
                ← Retour à l'accueil
            </a>
        </div>

    </div>
</div>
{% endblock %}