<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; background: #f5f5f5; margin: 0; padding: 20px; }
        .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 8px; padding: 40px; }
        .info { background: #f9f9f9; border-radius: 6px; padding: 20px; margin: 20px 0; }
        .bouton { display: inline-block; background: #8b5a2b; color: #fff; padding: 12px 20px; border-radius: 6px; text-decoration: none; }
        .footer { text-align: center; margin-top: 30px; color: #999; font-size: 12px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>📦 Votre commande est expédiée !</h1>
        <div class="info">
            <p><strong>Commande :</strong> {{ commande.numeroCommande }}</p>
            <p><strong>Transporteur :</strong> {{ commande.transporteur ?: livraison.transporteur }}</p>
            {% if commande.numeroSuivi %}<p><strong>Numéro de suivi :</strong> {{ commande.numeroSuivi }}</p>{% endif %}
            {% if commande.dateExpedition %}<p><strong>Expédiée le :</strong> {{ commande.dateExpedition|date('d/m/Y') }}</p>{% endif %}
            {% if commande.livraisonEstimeeTexte %}<p><strong>{{ commande.livraisonEstimeeTexte }}</strong></p>{% endif %}
        </div>
        {% if lien_suivi %}<p><a class="bouton" href="{{ lien_suivi }}">Suivre mon colis</a></p>{% endif %}
        {% set adresse = commande.adresseLivraisonFigee %}
        {% if adresse %}
            <p><strong>Adresse de livraison :</strong><br>
            {% if adresse.destinataire %}{{ adresse.destinataire }}<br>{% endif %}{{ adresse.rue }}<br>
            {% if adresse.complement %}{{ adresse.complement }}<br>{% endif %}{{ adresse.codePostal }} {{ adresse.ville }}</p>
        {% endif %}
        <p>Produits frais : pensez à les récupérer dès réception.</p>
        <div class="footer"><p>CreaSelf Cookies — Merci de votre confiance 🍪</p></div>
    </div>
</body>
</html>
