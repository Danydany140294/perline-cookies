{% set couleur = '#8b5a2b' %}
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"></head>
<body style="font-family: Arial, sans-serif; background:#f5f5f5; margin:0; padding:20px;">
<div style="max-width:560px; margin:0 auto; background:#fff; border-radius:8px; padding:36px;">
    <h1 style="font-size:22px; color:#333;">{{ titre }}</h1>
    <p style="color:#555; line-height:1.5;">{{ texte }}</p>
    <p style="margin:28px 0;"><a href="{{ lien }}" style="background:{{ couleur }}; color:#fff; padding:12px 22px; border-radius:6px; text-decoration:none;">Confirmer mon adresse</a></p>
    <p style="color:#888; font-size:12px;">Ce lien est valable 24 heures. Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :<br>{{ lien }}</p>
    <p style="color:#888; font-size:12px;">Si vous n'êtes pas à l'origine de cette demande, ignorez simplement ce message.</p>
    <p style="text-align:center; color:#999; font-size:12px; margin-top:30px;">{{ boutique.nom_marque }}</p>
</div>
</body>
</html>
