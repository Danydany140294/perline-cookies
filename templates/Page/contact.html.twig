{% extends 'base.html.twig' %}

{% block title %}Contact - CreaSelf{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/contact.css') }}">
{% endblock %}

{% block body %}
    <main class="contact-universe">
        <section class="contact-hero fade-in">
            <h1 class="gradient-text">Parle <span>Nous</span></h1>
            <p>Une question ? Une envie particulière ? Un devis ? L'équipe vous répondra...</p>
        </section>

        <section class="contact-container">
            <!-- Infos de contact -->
            <div class="contact-info glass" data-aos="fade-right">
                <div class="info-item">
                    <span class="neon-icon">✉️</span>
                    <h3>Perline Cookies</h3>
                    <p>Perlecook@perline-cookies.com</p>
                </div>
                <div class="info-item">
                    <span class="neon-icon">📍</span>
                    <h3>L'Atelier</h3>
                    <p>12 Rue du Sucre Holographique<br>34000 Montpellier</p>
                </div>
                <div class="social-links">
    <a href="#" class="social-icon">
        <i class="fab fa-instagram"></i>
        <span>Instagram</span>
    </a>
    <a href="#" class="social-icon">
        <i class="fab fa-tiktok"></i>
        <span>TikTok</span>
    </a>
</div>
            </div>

            <!-- Formulaire Futuriste -->
            <div class="contact-form-wrapper glass" data-aos="fade-left">
                {{ form_start(form, {attr: {id: 'future-form', novalidate: 'novalidate'}}) }}
                    {% for champ in [form.nom, form.email, form.sujet, form.message] %}
                    <div class="input-group">
                        {{ form_widget(champ) }}
                        {{ form_label(champ) }}
                        <div class="bar"></div>
                        {% for erreur in champ.vars.errors %}
                            <p class="field-error">{{ erreur.message }}</p>
                        {% endfor %}
                    </div>
                    {% endfor %}

                    {# Champ piège anti-spam : masqué aux humains, ne pas le remplir #}
                    <div class="hp-field" aria-hidden="true">
                        {{ form_label(form.site_web, 'Ne pas remplir ce champ') }}
                        {{ form_widget(form.site_web) }}
                    </div>

                    {% for erreur in form.vars.errors %}
                        <p class="field-error">{{ erreur.message }}</p>
                    {% endfor %}

                    <button type="submit" class="btn-send">
                        <span>ENVOYER L'ÉTINCELLE</span>
                        <div class="btn-glow"></div>
                    </button>
                {{ form_end(form) }}
            </div>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
  <script src="{{ asset('js/contact.js') }}"></script>
    
{% endblock %}