{% extends '@EasyAdmin/page/content.html.twig' %}

{% macro euros(montant) %}{{ montant|number_format(2, ',', ' ') }} €{% endmacro %}

{% block content_title %}Tableau de bord — {{ boutique.nom_marque }}{% endblock %}

{% block main %}
{% import _self as m %}
<div class="container-fluid" id="tableau-de-bord">

    {# ── Alertes ── #}
    {% set faibles = stats.stocks.faibles %}
    {% set ruptures = stats.stocks.ruptures %}
    {% set averifier = stats.a_verifier %}
    <div class="card mb-4 {{ (faibles or ruptures or averifier) ? 'border-warning' : 'border-success' }}" id="bloc-alertes">
        <div class="card-header fw-bold">Alertes</div>
        <div class="card-body">
            {% if not faibles and not ruptures and not averifier %}
                <p class="mb-0 text-success">Aucune alerte : tous les stocks sont au-dessus des seuils.</p>
            {% endif %}
            {% if averifier %}
                <p class="mb-1 fw-bold text-danger">Commandes à vérifier (paiement à contrôler)</p>
                <ul>{% for c in averifier %}<li class="alerte-a-verifier"><a href="{{ path('admin_dashboard_commande_detail', {entityId: c.id}) }}">{{ c.numeroCommande }}</a> : {{ c.dateCommande|date('d/m/Y H:i') }}, {{ c.user ? c.user.nomComplet : '—' }}</li>{% endfor %}</ul>
            {% endif %}
            {% if ruptures %}
                <p class="mb-1 fw-bold text-danger">Ruptures de stock</p>
                <ul>{% for produit in ruptures %}<li class="alerte-rupture"><a href="{{ path('admin_dashboard_produit_edit', {entityId: produit.id}) }}">{{ produit.name }}</a> : stock épuisé</li>{% endfor %}</ul>
            {% endif %}
            {% if faibles %}
                <p class="mb-1 fw-bold text-warning">Stocks faibles</p>
                <ul>{% for f in faibles %}<li class="alerte-stock"><a href="{{ path('admin_dashboard_produit_edit', {entityId: f.produit.id}) }}">{{ f.produit.name }}</a> : {{ f.produit.stock }} en stock (seuil {{ f.seuil }})</li>{% endfor %}</ul>
            {% endif %}
            <small class="text-muted">Seuil global : {{ seuil_global }} (modifiable par cookie dans sa fiche).</small>
        </div>
    </div>

    {# ── Commandes ── #}
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card h-100 text-center"><div class="card-body">
            <div class="fs-2 fw-bold" id="stat-commandes-jour">{{ stats.commandes_du_jour }}</div><div>Commandes payées aujourd'hui</div></div></div></div>
        <div class="col-md-4"><div class="card h-100 text-center"><div class="card-body">
            <div class="fs-2 fw-bold" id="stat-en-attente">{{ stats.en_attente_paiement }}</div><div>En attente de paiement</div></div></div></div>
        <div class="col-md-4"><div class="card h-100 text-center"><div class="card-body">
            <div class="fs-2 fw-bold" id="stat-a-preparer">{{ stats.a_preparer }}</div><div>À préparer</div></div></div></div>
    </div>

    {# ── Chiffre d'affaires payé ── #}
    <div class="row g-3 mb-4">
        {% for periode, ca in {'Aujourd\'hui': stats.ca_jour, 'Ce mois-ci': stats.ca_mois} %}
            <div class="col-md-6"><div class="card h-100"><div class="card-body">
                <div class="fw-bold mb-2">Chiffre d'affaires payé — {{ periode }}</div>
                <div class="fs-3" id="ca-{{ loop.first ? 'jour' : 'mois' }}-ttc">{{ m.euros(ca.ttc) }} <small class="text-muted">TTC</small></div>
                <div class="fs-5" id="ca-{{ loop.first ? 'jour' : 'mois' }}-ht">{{ m.euros(ca.ht) }} <small class="text-muted">HT</small></div>
                <small class="text-muted">{{ ca.commandes }} commande(s), hors annulations et remboursements.{% if ca.sans_ht > 0 %} {{ ca.sans_ht }} commande(s) antérieure(s) à la TVA figée : HT non disponible.{% endif %}</small>
            </div></div></div>
        {% endfor %}
    </div>

    {# ── Dernières commandes ── #}
    <div class="card mb-4" id="bloc-dernieres-commandes">
        <div class="card-header fw-bold">Dernières commandes</div>
        <table class="table mb-0">
            <thead><tr><th>Numéro</th><th>Date</th><th>Client</th><th>Statut</th><th class="text-end">Total TTC</th></tr></thead>
            <tbody>
            {% for commande in stats.dernieres_commandes %}
                <tr>
                    <td><a href="{{ path('admin_dashboard_commande_detail', {entityId: commande.id}) }}">{{ commande.numeroCommande }}</a></td>
                    <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                    <td>{{ commande.user ? commande.user.nomComplet : '—' }}</td>
                    <td>{{ commande.statutLabel }}</td>
                    <td class="text-end">{{ m.euros(commande.totalTTC) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-muted">Aucune commande.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# ── Utilisateurs (secondaire, administrateur seulement) ── #}
    {% if userCount is defined %}
        <h2 class="h5 text-muted mb-3">Utilisateurs</h2>
        <div class="row g-3 mb-4" id="bloc-utilisateurs">
            <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="fs-4">{{ userCount }}</div>Utilisateurs</div></div></div>
            <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="fs-4">{{ adminsCount }}</div>Administrateurs</div></div></div>
            <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="fs-4">{{ usersCount }}</div>Clients</div></div></div>
        </div>
    {% endif %}
</div>
{% endblock %}
